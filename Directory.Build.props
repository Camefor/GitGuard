<Project>

  <!--
    GitGuard 全仓库统一编译配置。
    依据：docs/03-系统架构设计(SAD).md §5.1、docs/13-开发规范.md §2-§4、ADR-0001、ADR-0002。
  -->

  <!-- ===== 通用编译属性 ===== -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 产品版本（06-API接口设计 §2 SemVer）：写入程序集、version 命令、Hook 标记行与审计 gitguard_version，须与 docs 变更记录一致 -->
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- ADR-0002：Native AOT 为发行形态，非桌面端项目从骨架期起保持 trim-safe 分析 -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' != 'GitGuard.Desktop' And !$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <!-- ===== 测试项目通用属性 ===== -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- 所有测试项目启用 MTP 覆盖率扩展（16-测试方案 §11：CI 生成并归档 coverage） -->
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" PrivateAssets="all" />
  </ItemGroup>

  <!-- ===== 代码分析器（13-开发规范 §2） ===== -->
  <ItemGroup>
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" />
  </ItemGroup>

  <!-- ===== 分层边界守卫（SAD §6 / ADR-0001）：Cli / Desktop 禁止直接引用 Infrastructure ===== -->
  <!-- 设计时构建（dotnet format / IDE 工作区加载）会注入传递引用，跳过以免误报；真实构建仍强制校验。 -->
  <Target Name="GitGuardEnforceArchitectureBoundaries" BeforeTargets="PrepareForBuild"
          Condition="('$(MSBuildProjectName)' == 'GitGuard.Cli' Or '$(MSBuildProjectName)' == 'GitGuard.Desktop') And '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <_GitGuardProjectReferences>@(ProjectReference)</_GitGuardProjectReferences>
    </PropertyGroup>
    <Error Condition="$([System.String]::Copy('$(_GitGuardProjectReferences)').Contains('GitGuard.Infrastructure'))"
           Text="架构违规（SAD §6 / ADR-0001）：$(MSBuildProjectName) 不得直接引用 GitGuard.Infrastructure，必须经由 GitGuard.Application 访问。" />
  </Target>

</Project>
