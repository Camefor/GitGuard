<Project>

  <!--
    中央包管理（Central Package Management）。
    ADR-0002：所有依赖固定版本，避免跨版本漂移；新增依赖必须在此登记并注明用途（13-开发规范 §11 DoD）。
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="代码分析">
    <!-- C# 代码风格规则（docs/13-开发规范.md §2） -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
    <!-- 代码质量与现代化检查 -->
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <!-- DR-01：禁止引用 System.Net.Http / System.Net.Sockets（见 BannedSymbols.txt） -->
    <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
  </ItemGroup>

  <ItemGroup Label="CLI">
    <!-- 命令行解析（ADR-0002 / SAD §2.1：CLI 框架 = System.CommandLine）；2.0 GA 起正式稳定，trim/AOT 兼容 -->
    <PackageVersion Include="System.CommandLine" Version="2.0.13" />
  </ItemGroup>

  <ItemGroup Label="存储">
    <!-- 本地审计存储（05-数据库设计 §1 / ADR-0002）；随包分发 e_sqlite3 原生库，AOT 兼容性见 ADR-0002 后续动作验证记录 -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="规则加载">
    <!-- 内置规则 YAML 解析（ADR-0002：配置解析 = YamlDotNet；AOT 验证见 ADR-0002 后续动作） -->
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- YamlDotNet 官方静态上下文源生成器（MIT，随 YamlDotNet 维护）：
         AOT 下以生成代码替代反射式类型检查，消除 IL2026/IL3050 警告 -->
    <PackageVersion Include="Vecc.YamlDotNet.Analyzers.StaticGenerator" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <!-- 单元测试框架（SAD §2：xUnit v3） -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <!-- 断言库；锁定 7.x（Apache-2.0），8.x 起改为商业许可，MVP 不引入许可风险 -->
    <PackageVersion Include="FluentAssertions" Version="7.2.2" />
    <!-- MTP 覆盖率扩展（16-测试方案 §11：CI 归档 coverage；与 xunit.v3 的 MTP v2 匹配） -->
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
  </ItemGroup>

</Project>
