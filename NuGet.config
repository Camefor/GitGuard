<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    包源固定为 nuget.org：中央包管理（CPM）要求显式包源映射（NU1507），
    同时保证本地与 CI（GGD-0011）行为一致、依赖来源可审计（供应链安全）。
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>
