  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>gitguard-benchmarks</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GitGuard.Detection\GitGuard.Detection.csproj" />
  </ItemGroup>

</Project>
