<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGuard.Desktop.ViewModels"
             xmlns:views="using:GitGuard.Desktop.Views"
             x:Class="GitGuard.Desktop.Views.RepositoriesView"
             x:DataType="vm:RepositoriesViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.repoName">
      <Setter Property="Foreground" Value="{DynamicResource GitGuardPrimaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.repoPath">
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSecondaryTextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.repoName">
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarTextBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected TextBlock.repoPath">
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarMutedBrush}" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource GitGuardSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarTextBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource GitGuardSidebarHoverBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="{DynamicResource GitGuardDangerTextBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*" Margin="32" RowSpacing="16">

    <StackPanel Grid.Row="0" Spacing="4">
      <TextBlock Text="{Binding Title}"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
      <TextBlock Text="{Binding Subtitle}"
                 Classes="secondary"
                 FontSize="14"
                 TextWrapping="Wrap" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="340,*" ColumnSpacing="20">

      <!-- 左栏：登记入口 + 已登记仓库列表 -->
      <Border Background="{DynamicResource GitGuardSurfaceBrush}"
              BorderBrush="{DynamicResource GitGuardBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="16">
        <Grid RowDefinitions="Auto,*">

          <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock Text="{Binding ListTitle}"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
            <TextBlock Text="{Binding PathLabel}"
                       FontSize="12"
                       Classes="secondary" />
            <TextBox Text="{Binding NewRepositoryPath}"
                     Watermark="{Binding PathWatermark}"
                     CornerRadius="8" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <Button Grid.Column="0"
                      Content="{Binding AddButtonText}"
                      Command="{Binding AddCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      Classes="primary"
                      HorizontalAlignment="Stretch"
                      HorizontalContentAlignment="Center" />
              <Button Grid.Column="1"
                      Content="{Binding RefreshButtonText}"
                      Command="{Binding RefreshCommand}"
                      IsEnabled="{Binding !IsBusy}"
                      CornerRadius="8" />
            </Grid>
            <TextBlock Text="{Binding ListMessage}"
                       IsVisible="{Binding HasListMessage}"
                       Classes="error"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>

          <Grid Grid.Row="1" Margin="0,16,0,0">
            <ListBox ItemsSource="{Binding Repositories}"
                     SelectedItem="{Binding SelectedRepository}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="10,8" />
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource GitGuardSelectedBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryItemViewModel">
                  <StackPanel Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="{Binding DisplayName}"
                                 Classes="repoName"
                                 FontSize="13"
                                 FontWeight="SemiBold" />
                      <Border IsVisible="{Binding IsMissing}"
                              Background="{DynamicResource GitGuardWarningSurfaceBrush}"
                              BorderBrush="{DynamicResource GitGuardWarningBorderBrush}"
                              BorderThickness="1"
                              CornerRadius="4"
                              Padding="6,1"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding MissingText}"
                                   FontSize="10"
                                   Foreground="{DynamicResource GitGuardWarningTextBrush}" />
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding RepoPath}"
                               Classes="repoPath"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyStateText}"
                       IsVisible="{Binding IsEmpty}"
                       Classes="secondary"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="8,12"
                       VerticalAlignment="Top" />
          </Grid>

        </Grid>
      </Border>

      <!-- 右栏：仓库详情 -->
      <Grid Grid.Column="1">
        <Border IsVisible="{Binding IsDetailVisible}"
                Background="{DynamicResource GitGuardSurfaceBrush}"
                BorderBrush="{DynamicResource GitGuardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24">
          <Grid RowDefinitions="*,Auto">
            <ScrollViewer Grid.Row="0"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="16">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Grid.Column="0" Spacing="3">
                    <TextBlock Text="{Binding SelectedRepository.DisplayName}"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                    <TextBlock Text="{Binding SelectedRepository.RepoPath}"
                               FontSize="11"
                               Classes="secondary"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedRepository.MissingText}"
                               IsVisible="{Binding SelectedRepository.IsMissing}"
                               Classes="error"
                               FontSize="11" />
                  </StackPanel>
                  <ProgressBar Grid.Column="1"
                               IsIndeterminate="True"
                               Width="96"
                               IsVisible="{Binding IsDetailLoading}" />
                </Grid>

                <TextBlock Text="{Binding DetailMessage}"
                           IsVisible="{Binding HasDetailMessage}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />

                <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Text="{Binding GitGuardVersionLabel}"
                               FontSize="11"
                               Classes="secondary" />
                    <TextBlock Text="{Binding GitGuardVersionText}"
                               FontSize="13"
                               Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding GitVersionLabel}"
                               FontSize="11"
                               Classes="secondary" />
                    <TextBlock Text="{Binding GitVersionText}"
                               FontSize="13"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="2">
                  <TextBlock Text="{Binding HooksDirectoryLabel}"
                             FontSize="11"
                             Classes="secondary" />
                  <TextBlock Text="{Binding HooksDirectoryText}"
                             FontSize="11"
                             Classes="secondary"
                             TextWrapping="Wrap" />
                </StackPanel>

                <Border Background="{DynamicResource GitGuardContentBrush}"
                        BorderBrush="{DynamicResource GitGuardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{Binding HooksTitle}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                    <ItemsControl ItemsSource="{Binding HookRows}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:HookStatusRowViewModel">
                          <Grid ColumnDefinitions="120,150,*" Margin="0,3">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding HookName}"
                                       FontFamily="Consolas"
                                       FontSize="12"
                                       Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusText}"
                                       FontSize="12"
                                       Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding VersionText}"
                                       FontSize="11"
                                       Classes="secondary" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding HookAttentionText}"
                               IsVisible="{Binding HasHookAttention}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource GitGuardWarningTextBrush}" />
                  </StackPanel>
                </Border>

                <Border Background="{DynamicResource GitGuardContentBrush}"
                        BorderBrush="{DynamicResource GitGuardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding LatestScanLabel}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                    <TextBlock Text="{Binding NoScanText}"
                               IsVisible="{Binding !HasLatestScan}"
                               Classes="secondary"
                               FontSize="12" />
                    <StackPanel IsVisible="{Binding HasLatestScan}" Spacing="2">
                      <TextBlock Text="{Binding LatestScanResultText}"
                                 FontSize="13"
                                 FontWeight="SemiBold"
                                 Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
                      <TextBlock Text="{Binding LatestScanText}"
                                 FontSize="11"
                                 Classes="secondary"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>

              </StackPanel>
            </ScrollViewer>

            <!-- GGD-0057：操作区固定在详情底部，WrapPanel 在窄窗口自动换行，避免按钮被裁切 -->
            <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="10">
              <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <Button Content="{Binding ScanButtonText}"
                        Command="{Binding ScanCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Classes="primary" />
                <Button Content="{Binding ScanHistoryButtonText}"
                        Command="{Binding OpenHistoryCommand}"
                        IsEnabled="{Binding CanInteract}"
                        CornerRadius="8" />
                <Button Content="{Binding InstallHookButtonText}"
                        Command="{Binding InstallHooksCommand}"
                        IsEnabled="{Binding CanManageHooks}"
                        Classes="primary" />
                <Button Content="{Binding UninstallHookButtonText}"
                        Command="{Binding RequestUninstallHooksCommand}"
                        IsEnabled="{Binding CanUninstallHooks}"
                        IsVisible="{Binding HasManagedHooks}"
                        Classes="dangerOutline" />
                <Button Content="{Binding AllowlistButtonText}"
                        Command="{Binding OpenAllowlistCommand}"
                        IsEnabled="{Binding CanInteract}"
                        CornerRadius="8" />
                <Button Content="{Binding RemoveButtonText}"
                        Command="{Binding RequestRemoveCommand}"
                        IsEnabled="{Binding CanInteract}"
                        Classes="dangerOutline" />
              </WrapPanel>

              <!-- GGD-0055：二进制 / 符号链接 Hook 的强制接管确认 -->
              <Border IsVisible="{Binding IsHookForceConfirmationVisible}"
                      Classes="warningPanel"
                      Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding HookForceConfirmPrompt}"
                             Classes="warning"
                             FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding ConfirmHookForceButtonText}"
                            Command="{Binding ConfirmHookForceInstallCommand}"
                            Classes="primary" />
                    <Button Content="{Binding CancelHookButtonText}"
                            Command="{Binding CancelHookForceCommand}"
                            Classes="warningSecondary" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <!-- GGD-0055：卸载 Hook 二次确认 -->
              <Border IsVisible="{Binding IsUninstallConfirmationVisible}"
                      Classes="warningPanel"
                      Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding HookUninstallConfirmPrompt}"
                             Classes="warning"
                             FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding ConfirmUninstallHookButtonText}"
                            Command="{Binding ConfirmUninstallHooksCommand}"
                            Classes="danger" />
                    <Button Content="{Binding CancelHookButtonText}"
                            Command="{Binding CancelUninstallHooksCommand}"
                            Classes="warningSecondary" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <Border IsVisible="{Binding IsRemoveConfirmationVisible}"
                      Classes="warningPanel"
                      Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock Text="{Binding RemoveConfirmPrompt}"
                             Classes="warning"
                             FontSize="12" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{Binding ConfirmRemoveButtonText}"
                            Command="{Binding ConfirmRemoveCommand}"
                            IsEnabled="{Binding !IsBusy}"
                            Classes="danger" />
                    <Button Content="{Binding CancelRemoveButtonText}"
                            Command="{Binding CancelRemoveCommand}"
                            Classes="warningSecondary" />
                  </StackPanel>
                </StackPanel>
              </Border>

            </StackPanel>
          </Grid>
        </Border>

        <Border IsVisible="{Binding IsSelectPromptVisible}"
                Background="{DynamicResource GitGuardSurfaceBrush}"
                BorderBrush="{DynamicResource GitGuardBorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="24">
          <TextBlock Text="{Binding SelectPromptText}"
                     Classes="secondary"
                     FontSize="13"
                     TextWrapping="Wrap"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     MaxWidth="360"
                     TextAlignment="Center" />
        </Border>
      </Grid>

    </Grid>

    <!-- 扫描历史子页面：覆盖整个仓库页内容区（GGD-0043） -->
    <Border Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsHistoryVisible}"
            Background="{DynamicResource GitGuardContentBrush}">
      <views:ScanHistoryView DataContext="{Binding History}" />
    </Border>

    <!-- 白名单子页面：覆盖整个仓库页内容区（GGD-0044） -->
    <Border Grid.Row="0"
            Grid.RowSpan="2"
            IsVisible="{Binding IsAllowlistVisible}"
            Background="{DynamicResource GitGuardContentBrush}">
      <views:AllowlistView DataContext="{Binding Allowlist}" />
    </Border>

  </Grid>
</UserControl>
