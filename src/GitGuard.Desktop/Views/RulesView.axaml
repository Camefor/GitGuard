<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitGuard.Desktop.ViewModels"
             x:Class="GitGuard.Desktop.Views.RulesView"
             x:DataType="vm:RulesViewModel">

  <UserControl.Styles>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSecondaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardPrimaryTextBrush}" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#C62828" />
    </Style>
    <Style Selector="TextBlock.itemId">
      <Setter Property="FontFamily" Value="Consolas" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardPrimaryTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.itemName">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardPrimaryTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource GitGuardSelectedBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarTextBrush}" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16,8" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="{DynamicResource GitGuardSidebarHoverBrush}" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="32" RowSpacing="16">

    <!-- 顶部：标题、加载状态与刷新 -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="16">
      <StackPanel Grid.Column="0" Spacing="4">
        <TextBlock Text="{Binding Title}"
                   FontSize="26"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
        <TextBlock Text="{Binding Subtitle}"
                   Classes="secondary"
                   FontSize="14"
                   TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="10"
                  VerticalAlignment="Center">
        <ProgressBar IsIndeterminate="True"
                     Width="96"
                     IsVisible="{Binding IsLoading}" />
        <Button Content="{Binding RefreshButtonText}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding CanInteract}"
                CornerRadius="8" />
      </StackPanel>
    </Grid>

    <!-- 筛选工具栏：搜索节流 200ms、来源 / 类别与有效启用 -->
    <Border Grid.Row="1"
            Background="{DynamicResource GitGuardSurfaceBrush}"
            BorderBrush="{DynamicResource GitGuardBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16">
      <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,150,170,Auto" ColumnSpacing="12">
          <TextBox Grid.Column="0"
                   Text="{Binding SearchText}"
                   Watermark="{Binding SearchWatermark}"
                   CornerRadius="8"
                   VerticalAlignment="Bottom" />

          <StackPanel Grid.Column="1" Spacing="4">
            <TextBlock Text="{Binding SourceFilterLabel}" Classes="fieldLabel" />
            <ComboBox ItemsSource="{Binding SourceFilters}"
                      SelectedItem="{Binding SelectedSourceFilter}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleFilterOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Grid.Column="2" Spacing="4">
            <TextBlock Text="{Binding CategoryFilterLabel}" Classes="fieldLabel" />
            <ComboBox ItemsSource="{Binding CategoryFilters}"
                      SelectedItem="{Binding SelectedCategoryFilter}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleFilterOption">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <CheckBox Grid.Column="3"
                    Content="{Binding EnabledOnlyText}"
                    IsChecked="{Binding EnabledOnly}"
                    VerticalAlignment="Bottom" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
          <TextBlock Text="{Binding SummaryText}" Classes="hint" />
          <TextBlock Text="{Binding LoadMessage}"
                     IsVisible="{Binding HasLoadMessage}"
                     Classes="error"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- 主区：左列表 / 右详情 -->
    <Grid Grid.Row="2" ColumnDefinitions="*,420" ColumnSpacing="16">

      <Border Grid.Column="0"
              Background="{DynamicResource GitGuardSurfaceBrush}"
              BorderBrush="{DynamicResource GitGuardBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="14">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
          <TextBlock Grid.Row="0"
                     Text="{Binding RulesListTitle}"
                     Classes="sectionTitle" />

          <!-- Gitleaks 分类说明：动态规则不进入静态目录 -->
          <Border Grid.Row="1"
                  IsVisible="{Binding IsGitleaksInfoVisible}"
                  Background="#FFF3CD"
                  CornerRadius="8"
                  Padding="12">
            <TextBlock Text="{Binding GitleaksInfoText}"
                       FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="#5C4500" />
          </Border>

          <Grid Grid.Row="2">
            <ListBox ItemsSource="{Binding VisibleRules}"
                     SelectedItem="{Binding SelectedRule}"
                     Background="Transparent"
                     BorderThickness="0">
              <ListBox.Styles>
                <Style Selector="ListBoxItem">
                  <Setter Property="Padding" Value="10,8" />
                  <Setter Property="Margin" Value="0,1" />
                  <Setter Property="CornerRadius" Value="8" />
                </Style>
                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                  <Setter Property="Background" Value="{DynamicResource GitGuardSelectedBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock.itemId">
                  <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarTextBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock.itemName">
                  <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarTextBrush}" />
                </Style>
                <Style Selector="ListBoxItem:selected TextBlock.hint">
                  <Setter Property="Foreground" Value="{DynamicResource GitGuardSidebarMutedBrush}" />
                </Style>
              </ListBox.Styles>
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:RuleItemViewModel">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Spacing="2">
                      <TextBlock Text="{Binding RuleId}" Classes="itemId" />
                      <TextBlock Text="{Binding Name}" Classes="itemName" />
                      <TextBlock Text="{Binding MetaText}" Classes="hint" />
                    </StackPanel>
                    <Border Grid.Column="1"
                            IsVisible="{Binding Enabled}"
                            Background="#E8F5E9"
                            CornerRadius="4"
                            Padding="6,1"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding EnabledText}"
                                 FontSize="10"
                                 Foreground="#2E7D32" />
                    </Border>
                    <Border Grid.Column="1"
                            IsVisible="{Binding !Enabled}"
                            Background="#EEEEEE"
                            CornerRadius="4"
                            Padding="6,1"
                            VerticalAlignment="Top">
                      <TextBlock Text="{Binding EnabledText}"
                                 FontSize="10"
                                 Foreground="#616161" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="{Binding EmptyStateText}"
                       IsVisible="{Binding IsEmpty}"
                       Classes="hint"
                       FontSize="12"
                       Margin="8,12"
                       VerticalAlignment="Top"
                       TextWrapping="Wrap" />
          </Grid>
        </Grid>
      </Border>

      <Border Grid.Column="1"
              Background="{DynamicResource GitGuardSurfaceBrush}"
              BorderBrush="{DynamicResource GitGuardBorderBrush}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="20">
        <ScrollViewer>
          <Grid>
            <StackPanel IsVisible="{Binding HasSelectedRule}" Spacing="14">
              <TextBlock Text="{Binding DetailTitle}"
                         Classes="sectionTitle" />

              <StackPanel Spacing="3">
                <TextBlock Text="{Binding SelectedRule.RuleId}"
                           FontFamily="Consolas"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedRule.Name}"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Grid ColumnDefinitions="110,*"
                    RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                    RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="{Binding RuleIdLabel}" Classes="fieldLabel" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Text="{Binding SelectedRule.RuleId}"
                           FontFamily="Consolas" FontSize="12"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="{Binding RuleNameLabel}" Classes="fieldLabel" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding SelectedRule.Name}"
                           FontSize="12"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}"
                           TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Text="{Binding CategoryFieldLabel}" Classes="fieldLabel" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding SelectedRule.CategoryText}"
                           FontSize="12"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Text="{Binding SeverityFieldLabel}" Classes="fieldLabel" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Text="{Binding SelectedRule.SeverityText}"
                           FontSize="12"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Text="{Binding SourceFieldLabel}" Classes="fieldLabel" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Text="{Binding SelectedRule.SourceText}"
                           FontSize="12"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Text="{Binding StatusFieldLabel}" Classes="fieldLabel" />
                <TextBlock Grid.Row="5" Grid.Column="1"
                           Text="{Binding SelectedRule.EnabledText}"
                           FontSize="12"
                           Foreground="{DynamicResource GitGuardPrimaryTextBrush}" />
              </Grid>

              <Border Background="{DynamicResource GitGuardContentBrush}"
                      BorderBrush="{DynamicResource GitGuardBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="8"
                      Padding="12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               Text="{Binding PatternLabel}"
                               Classes="fieldLabel"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Content="{Binding PatternToggleText}"
                            Command="{Binding TogglePatternCommand}"
                            IsEnabled="{Binding CanTogglePattern}"
                            CornerRadius="8" />
                  </Grid>
                  <TextBox Text="{Binding SelectedPatternText, Mode=OneWay}"
                           IsReadOnly="True"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           FontFamily="Consolas"
                           FontSize="11"
                           MinHeight="76"
                           MaxHeight="180" />
                  <TextBlock Text="{Binding PatternHint}" Classes="hint" />
                </StackPanel>
              </Border>
            </StackPanel>

            <TextBlock Text="{Binding SelectRulePrompt}"
                       IsVisible="{Binding !HasSelectedRule}"
                       Classes="hint"
                       FontSize="13"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       MaxWidth="320"
                       TextAlignment="Center" />
          </Grid>
        </ScrollViewer>
      </Border>

    </Grid>

  </Grid>
</UserControl>
