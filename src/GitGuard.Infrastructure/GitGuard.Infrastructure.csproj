<Project Sdk="Microsoft.NET.Sdk">

  <!-- 基础设施层：Git CLI 调用（IGitAccess）/ SQLite 审计（IAuditStore）/ 文件系统 / 脱敏日志 Sink（SAD §5.1）。 -->

  <PropertyGroup>
    <!-- GGD-0061：LibraryImport 源生成互操作（Windows WM_SETTINGCHANGE 广播）要求启用不安全代码生成。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitGuard.Core\GitGuard.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ADR-0002：SQLite via Microsoft.Data.Sqlite（EF Core 不引入，迁移器自写：05-数据库设计 §6） -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- 迁移脚本随程序集内嵌（05-数据库设计 §6：Sqlite/Migrations/VNNN_<description>.sql） -->
    <EmbeddedResource Include="Sqlite\Migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- GGD-0056：内部启动配置工厂需要被基础设施测试直接断言 -->
    <InternalsVisibleTo Include="GitGuard.Infrastructure.Tests" />
  </ItemGroup>

</Project>
